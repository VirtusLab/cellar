package build.signatureBench

import mill.*
import mill.scalalib.*

/** Compares cellar's printed signatures with the declarations in published sources jars. Defined
  * here rather than in build.mill so `compare.sh` can drop the whole folder into another checkout.
  */
object `package` extends build.CommonScalaModule {
  def moduleDeps = Seq(build.lib)
  def mvnDeps = Seq(
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core:2.41.6",
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros:2.41.6"
  )
  def mainClass  = Some("cellar.bench.Main")

  object test extends ScalaTests with TestModule.Munit {
    def mvnDeps = super.mvnDeps() ++ Seq(mvn"org.scalameta::munit:1.3.6")
  }
}
